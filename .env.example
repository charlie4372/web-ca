NODE_ENV=development
PORT=3000
DATABASE_URL=./data/webca.db
SESSION_SECRET=change-this-to-a-random-string-at-least-32-chars
CERT_ENCRYPTION_KEY=change-this-to-a-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:5173

# Docker/reverse proxy settings
TRUST_PROXY=false
# auto = secure in production, not in dev. Set to 'false' if running Docker without HTTPS.
SECURE_COOKIES=auto
